{
  "name": "passacaglia-ts",
  "private": true,
  "type": "module",
  "description": "Monorepo for `passacaglia`, an experimental procedural music engine",
  "version": "1.0.0",
  "scripts": {
    "dev:pkgs": "pnpm -r --sort --parallel --filter='./packages/*' dev",
    "dev": "pnpm concurrently -k \"pnpm run dev:pkgs\" \"pnpm --filter='debug-ui' dev\""
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "vitest": "^5.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  }
}
